*.py[cod]
.pytest_cache/
/.deps/
/.verification/
/.venv/
/venv/
/MIGRATION.json

# Source datasets and generated model/score arrays stay local.
# Anchor data to the root: vendor/needle/data contains required Python source.
/data/
/checkpoints/
*.npy
*.npz
*.parquet
*.duckdb
*.duckdb.wal
*.sqlite
*.sqlite3
*.pt
