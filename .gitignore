# Archives may contain datasets. Keep only the report notebook in deliverables.
*.zip
*.tar
*.tar.gz
*.7z
/deliverables/*
!/deliverables/Needle_MASTER_Report.ipynb

# Private build/validation output and rehearsal logs
/checkin/.build/
/checkin/.chart-data-*/
/checkin/demo_runs/
/checkin/*.docx
/results/real_training_smoke_v*/
/results/*_before_*.json
/results/*_pre_migration.json
/results/gpu_benchmark_smoke.json
/results/*verification*.json

